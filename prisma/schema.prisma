generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String         @id @default(cuid())
  name                     String?
  email                    String?        @unique
  image                    String?
  role                     Role           @default(READER)
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  bannerImage              String?
  bio                      String?
  discordUrl               String?
  emailVerified            DateTime?
  instagramUrl             String?
  stripeAccountId          String?        @unique
  twitterUrl               String?
  websiteUrl               String?
  youtubeUrl               String?
  writerPolicyAcknowledged Boolean        @default(false)
  writerStatus             WriterStatus   @default(BEGINNER)
  /// Who sees the content of this member's reading profile (/reader/[id]):
  /// Library and later sections. The header (picture, banner, name, bio) is
  /// always visible to anyone with the link. Author pages are always public.
  readingProfileVisibility ProfileVisibility @default(PRIVATE)
  /// Voluntary 18+ confirmation (Settings > Account). Only the time and the
  /// wording version are stored, never the birthdate. Null = not confirmed.
  /// Nothing is gated on it yet (later: mature content, purchases/payouts).
  ageConfirmedAt           DateTime?
  ageConfirmationVersion   String?
  passwordHash             String?
  accounts                 Account[]
  adImpressions            AdImpression[]
  payouts                  AuthorPayout[]
  books                    Book[]
  episodes                 Episode[]
  authorProfile            AuthorProfile?
  ownedStudios             Studio[]       @relation("StudioOwner")
  readEvents               ReadEvent[]
  series                   Series[]
  sessions                 Session[]
  studioMemberships        StudioMembership[]
  subscriptions            Subscription[]
  stats                    UserStats?
  restrictions             MemberRestriction[] @relation("RestrictedMember")
  restrictionsImposed      MemberRestriction[] @relation("RestrictionImposer")
  restrictionsLifted       MemberRestriction[] @relation("RestrictionLifter")
  auditActions             AdminAuditLog[]     @relation("AuditActor")
  auditEntries             AdminAuditLog[]     @relation("AuditTarget")
  platformAvatarsAdded     PlatformAvatar[]
  seriesFollows            SeriesFollow[]
}

model AuthorProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  displayName   String
  bio           String?
  profileImage  String?
  creatorTagline String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Studio {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  description String?
  kind        StudioKind
  ownerId     String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  memberships StudioMembership[]
  owner       User?             @relation("StudioOwner", fields: [ownerId], references: [id], onDelete: SetNull)
}

model StudioMembership {
  id         String           @id @default(cuid())
  userId     String
  studioId   String
  accessRole StudioAccessRole @default(MEMBER)
  createdAt  DateTime         @default(now())
  studio     Studio           @relation(fields: [studioId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, studioId])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @id @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model Series {
  id          String     @id @default(cuid())
  title       String
  description String
  genre       String
  tags        String[]
  coverImage  String?
  themeColor  String?
  status      SeriesStatus @default(DRAFT)
  reads       Int        @default(0)
  followers   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  authorId    String
  aiUsageTag  AiUsageTag
  episodes    Episode[]
  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  follows     SeriesFollow[]
}

/// A member following a series (separate from following an author). Their
/// Library is these rows, published series only. Series.followers is kept equal
/// to this table's row count by a database trigger (migration
/// 20261010090000_series_follows, "SeriesFollow_count"); never update it by hand.
model SeriesFollow {
  userId    String
  seriesId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@id([userId, seriesId])
  @@index([userId, createdAt])
  @@index([seriesId])
}

model Episode {
  id            String         @id @default(cuid())
  title         String
  episodeNumber Int
  description   String?
  contentWarning String?
  body          String
  teaser        String?
  readTime      Int
  readerCount   Int            @default(0)
  locked        Boolean        @default(false)
  coverImage    String?
  status        EpisodeStatus  @default(DRAFT)
  publishedAt   DateTime?
  lastSavedAt   DateTime       @default(now())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  seriesId      String
  authorId      String
  aiUsageTag    AiUsageTag
  adImpressions AdImpression[]
  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  series        Series         @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  readEvents    ReadEvent[]

  @@unique([seriesId, episodeNumber])
}

model UserStats {
  id            String @id @default(cuid())
  totalReads    Int    @default(0)
  totalEpisodes Int    @default(0)
  totalSeries   Int    @default(0)
  userId        String @unique
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Settings {
  id                    String          @id @default(cuid())
  siteName              String          @default("Dramatized Fiction")
  enableAds             Boolean         @default(false)
  enablePayments        Boolean         @default(false)
  updatedAt             DateTime        @updatedAt
  phaseThreeUnlocked    Boolean         @default(false)
  phaseTwoUnlocked      Boolean         @default(false)
  // When each phase was activated from CEO Studio (null = never).
  phaseTwoActivatedAt   DateTime?
  phaseThreeActivatedAt DateTime?
  // Renovation Mode: the public sees the renovation page; CEO and Board keep access.
  renovationMode        Boolean         @default(false)
  renovationChangedAt   DateTime?
  // Platform default profile pictures (null = the built-in defaults in public/avatars).
  defaultReaderAvatarId String?
  defaultWriterAvatarId String?
  defaultReaderAvatar   PlatformAvatar? @relation("DefaultReaderAvatar", fields: [defaultReaderAvatarId], references: [id], onDelete: SetNull)
  defaultWriterAvatar   PlatformAvatar? @relation("DefaultWriterAvatar", fields: [defaultWriterAvatarId], references: [id], onDelete: SetNull)
}

// A permanent ban (endsAt null) or a one-month discipline action. Active while
// liftedAt is null and (for discipline) endsAt is in the future, so discipline
// ends on its own without a scheduled job. Rows are kept as history.
model MemberRestriction {
  id          String          @id @default(cuid())
  userId      String
  kind        RestrictionKind
  // Private administrative note; never shown to the member.
  reason      String
  imposedById String?
  imposedAt   DateTime        @default(now())
  endsAt      DateTime?
  liftedById  String?
  liftedAt    DateTime?
  liftNote    String?
  user        User            @relation("RestrictedMember", fields: [userId], references: [id], onDelete: Cascade)
  imposedBy   User?           @relation("RestrictionImposer", fields: [imposedById], references: [id], onDelete: SetNull)
  liftedBy    User?           @relation("RestrictionLifter", fields: [liftedById], references: [id], onDelete: SetNull)

  @@index([userId, liftedAt])
}

// Who did what to whom, for sensitive administrative actions. Never stores
// passwords or other secrets.
model AdminAuditLog {
  id           String   @id @default(cuid())
  action       String
  actorId      String?
  targetUserId String?
  details      Json?
  createdAt    DateTime @default(now())
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUser   User?    @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([actorId, action, createdAt])
  @@index([targetUserId, createdAt])
}

// Shared avatars uploaded by Administration; one may be the Reader default and
// one the Writer default (Settings). Members' own pictures stay on User.image.
model PlatformAvatar {
  id                String     @id @default(cuid())
  label             String
  url               String     @unique
  createdAt         DateTime   @default(now())
  createdById       String?
  createdBy         User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  defaultForReaders Settings[] @relation("DefaultReaderAvatar")
  defaultForWriters Settings[] @relation("DefaultWriterAvatar")
}

model AuthorPayout {
  id          String       @id @default(cuid())
  amount      Int
  status      PayoutStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  processedAt DateTime?
  authorId    String
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model Subscription {
  id          String    @id @default(cuid())
  stripeSubId String    @unique
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  canceledAt  DateTime?
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RevenueEvent {
  id        String      @id @default(cuid())
  type      RevenueType
  amount    Int
  userId    String?
  seriesId  String?
  episodeId String?
  createdAt DateTime    @default(now())
}

model AdImpression {
  id        String   @id @default(cuid())
  userId    String?
  episodeId String
  createdAt DateTime @default(now())
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId, episodeId])
}

model ReadEvent {
  id        String   @id @default(cuid())
  userId    String?
  episodeId String
  createdAt DateTime @default(now())
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([episodeId, createdAt])
}

model Book {
  id          String   @id @default(cuid())
  title       String
  description String?
  coverUrl    String?
  status      String
  createdAt   DateTime @default(now())
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model CmsArticle {
  id                  String   @id @default(cuid())
  slug                String   @unique
  title               String
  quickSectionContent String
  deepSectionContent  String
  lastUpdated         DateTime @updatedAt
  createdAt           DateTime @default(now())
}

enum Role {
  READER
  WRITER
  BOARD
  CEO
}

enum ProfileVisibility {
  PRIVATE
  PUBLIC
}

enum RestrictionKind {
  BAN
  DISCIPLINE
}

enum WriterStatus {
  BEGINNER
  FULL
  FEATURED
  ELITE
}

enum AiUsageTag {
  AI_FREE
  AI_CORRECTED
  AI_HEAVY
  AI_WRITTEN
}

enum PayoutStatus {
  PENDING
  PAID
  FAILED
}

enum SeriesStatus {
  DRAFT
  PUBLISHED
}

enum EpisodeStatus {
  DRAFT
  REVIEW
  PUBLISHED
}

enum RevenueType {
  SUBSCRIPTION
  AD_WATCH
  EPISODE_READ
}

enum StudioKind {
  PERSONAL
  SHARED
  OFFICIAL
  EXECUTIVE
}

enum StudioAccessRole {
  MEMBER
  EDITOR
  MANAGER
  OWNER
}
