generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String         @id @default(cuid())
  name                     String?
  email                    String?        @unique
  image                    String?
  role                     Role           @default(READER)
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  bannerImage              String?
  bio                      String?
  discordUrl               String?
  emailVerified            DateTime?
  instagramUrl             String?
  stripeAccountId          String?        @unique
  twitterUrl               String?
  websiteUrl               String?
  youtubeUrl               String?
  writerPolicyAcknowledged Boolean        @default(false)
  writerStatus             WriterStatus   @default(BEGINNER)
  passwordHash             String?
  accounts                 Account[]
  adImpressions            AdImpression[]
  payouts                  AuthorPayout[]
  books                    Book[]
  episodes                 Episode[]
  authorProfile            AuthorProfile?
  ownedStudios             Studio[]       @relation("StudioOwner")
  readEvents               ReadEvent[]
  series                   Series[]
  sessions                 Session[]
  studioMemberships        StudioMembership[]
  subscriptions            Subscription[]
  stats                    UserStats?
}

model AuthorProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  displayName   String
  bio           String?
  profileImage  String?
  creatorTagline String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Studio {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  description String?
  kind        StudioKind
  ownerId     String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  memberships StudioMembership[]
  owner       User?             @relation("StudioOwner", fields: [ownerId], references: [id], onDelete: SetNull)
}

model StudioMembership {
  id         String           @id @default(cuid())
  userId     String
  studioId   String
  accessRole StudioAccessRole @default(MEMBER)
  createdAt  DateTime         @default(now())
  studio     Studio           @relation(fields: [studioId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, studioId])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @id @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model Series {
  id          String     @id @default(cuid())
  title       String
  description String
  genre       String
  tags        String[]
  coverImage  String?
  reads       Int        @default(0)
  followers   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  authorId    String
  aiUsageTag  AiUsageTag
  episodes    Episode[]
  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model Episode {
  id            String         @id @default(cuid())
  title         String
  episodeNumber Int
  body          String
  teaser        String?
  readTime      Int
  readerCount   Int            @default(0)
  locked        Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  seriesId      String
  authorId      String
  aiUsageTag    AiUsageTag
  adImpressions AdImpression[]
  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  series        Series         @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  readEvents    ReadEvent[]

  @@unique([seriesId, episodeNumber])
}

model UserStats {
  id            String @id @default(cuid())
  totalReads    Int    @default(0)
  totalEpisodes Int    @default(0)
  totalSeries   Int    @default(0)
  userId        String @unique
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Settings {
  id                 String   @id @default(cuid())
  siteName           String   @default("Dramatized Fiction")
  enableAds          Boolean  @default(false)
  enablePayments     Boolean  @default(false)
  updatedAt          DateTime @updatedAt
  phaseThreeUnlocked Boolean  @default(false)
  phaseTwoUnlocked   Boolean  @default(false)
}

model AuthorPayout {
  id          String       @id @default(cuid())
  amount      Int
  status      PayoutStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  processedAt DateTime?
  authorId    String
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model Subscription {
  id          String    @id @default(cuid())
  stripeSubId String    @unique
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  canceledAt  DateTime?
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RevenueEvent {
  id        String      @id @default(cuid())
  type      RevenueType
  amount    Int
  userId    String?
  seriesId  String?
  episodeId String?
  createdAt DateTime    @default(now())
}

model AdImpression {
  id        String   @id @default(cuid())
  userId    String?
  episodeId String
  createdAt DateTime @default(now())
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId, episodeId])
}

model ReadEvent {
  id        String   @id @default(cuid())
  userId    String?
  episodeId String
  createdAt DateTime @default(now())
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([episodeId, createdAt])
}

model Book {
  id          String   @id @default(cuid())
  title       String
  description String?
  coverUrl    String?
  status      String
  createdAt   DateTime @default(now())
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model CmsArticle {
  id                  String   @id @default(cuid())
  slug                String   @unique
  title               String
  quickSectionContent String
  deepSectionContent  String
  lastUpdated         DateTime @updatedAt
  createdAt           DateTime @default(now())
}

enum Role {
  READER
  AUTHOR
  ADMIN
  BOARD
  CEO
}

enum WriterStatus {
  BEGINNER
  FULL
  FEATURED
  ELITE
}

enum AiUsageTag {
  AI_FREE
  AI_CORRECTED
  AI_HEAVY
  AI_WRITTEN
}

enum PayoutStatus {
  PENDING
  PAID
  FAILED
}

enum RevenueType {
  SUBSCRIPTION
  AD_WATCH
  EPISODE_READ
}

enum StudioKind {
  PERSONAL
  SHARED
  OFFICIAL
  EXECUTIVE
}

enum StudioAccessRole {
  MEMBER
  EDITOR
  MANAGER
  OWNER
}
